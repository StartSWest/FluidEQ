# FluidEQ build-time configuration.
#
# Copy this file to `.env` and fill in the values you want. `.env` is
# gitignored; this example is the only one that gets committed.
#
#   cp .env.example .env
#
# Variables already set in the shell or in CI win over this file, so a release
# pipeline can inject its own values without editing anything.
#
# ---------------------------------------------------------------------------
# EVERYTHING IN THIS FILE IS PUBLIC.
#
# webpack inlines these into the renderer bundle, so every value ends up
# readable in the shipped JavaScript. Only put things here that are public by
# nature. A Stripe *Payment Link* and a receiving Bitcoin address qualify —
# they exist to be handed out. A Stripe SECRET KEY (sk_live_..., sk_test_...)
# or any other credential absolutely does not: putting one here ships it to
# every user. FluidEQ never needs one, because it only ever opens a URL.
# ---------------------------------------------------------------------------


# --- Optional: contribution destinations ------------------------------------
#
# Leave any of these blank to hide that option. Leave both the Stripe and
# Bitcoin values blank and the "Support the work" entry disappears from the
# app entirely — a build with no destination shows no donate button rather
# than a broken one.

# Stripe Payment Link, e.g. https://buy.stripe.com/xxxxxxxxxxxxxxxx
# Create one at https://dashboard.stripe.com/payment-links — a Payment Link
# needs no server and no API key, which is why it is the right fit here.
# Must be https: a plaintext URL is rejected so payment routing cannot be
# downgraded in transit.
FLUIDEQ_STRIPE_URL=

# On-chain Bitcoin receiving address (bech32 `bc1...`, or legacy `1...`/`3...`).
# Checked for shape before it is shown, so a placeholder or a pasted URL is
# ignored rather than displayed as a destination. VERIFY THIS VALUE: a typo
# sends contributions somewhere unrecoverable.
FLUIDEQ_BITCOIN_ADDRESS=

# Label a wallet shows when opening the BIP-21 link.
# Defaults to "FluidEQ development".
FLUIDEQ_BITCOIN_LABEL=

# Where people can contribute time instead of money.
# Defaults to https://github.com/StartSWest/FluidEQ
FLUIDEQ_REPOSITORY_URL=
