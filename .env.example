# FluidEQ build-time configuration.
#
# Copy this file to `.env` and fill in the values you want. `.env` is
# gitignored; this example is the only one that gets committed.
#
#   cp .env.example .env
#
# Variables already set in the shell or in CI win over this file, so a release
# pipeline can inject its own values without editing anything.
#
# ---------------------------------------------------------------------------
# EVERYTHING IN THIS FILE IS PUBLIC.
#
# webpack inlines these into the renderer bundle, so every value ends up
# readable in the shipped JavaScript. Only put things here that are public by
# nature. A Stripe *Payment Link* and a receiving Bitcoin address qualify —
# they exist to be handed out. A Stripe SECRET KEY (sk_live_..., sk_test_...)
# or any other credential absolutely does not: putting one here ships it to
# every user. FluidEQ never needs one, because it only ever opens a URL.
# ---------------------------------------------------------------------------


# --- Optional: contribution destinations ------------------------------------
#
# Leave any of these blank to hide that option. Leave *every* destination in
# this file blank — Stripe, Buy Me a Coffee and all of the crypto addresses —
# and the "Support the work" entry disappears from the app entirely. A build
# with no destination shows no donate button rather than a broken one.

# Stripe Payment Link, e.g. https://buy.stripe.com/xxxxxxxxxxxxxxxx
# Create one at https://dashboard.stripe.com/payment-links — a Payment Link
# needs no server and no API key, which is why it is the right fit here.
# Must be https: a plaintext URL is rejected so payment routing cannot be
# downgraded in transit.
FLUIDEQ_STRIPE_URL=

# Buy Me a Coffee or Ko-fi page, e.g. https://buymeacoffee.com/yourname
# Also https-only.
FLUIDEQ_COFFEE_URL=


# --- Optional: crypto addresses ---------------------------------------------
#
# Every one of these is independent — fill in only the chains you actually
# hold, and the rest stay hidden. Each is shape-checked before it is shown, so
# a placeholder or a pasted URL is ignored rather than displayed as a
# destination.
#
# VERIFY EVERY VALUE YOU PASTE. These are checked for *shape*, not for
# checksum: a typo that still looks like an address will be displayed, and
# funds sent to it are unrecoverable. The app also shows the network next to
# each address, because several of these formats are shared across chains.

# bech32 `bc1...`, or legacy `1...` / `3...`
FLUIDEQ_BITCOIN_ADDRESS=

# `0x...` — WARNING: every EVM chain uses this format. The address shown is
# labelled Ethereum mainnet, so do not put a Polygon/BSC-only address here.
FLUIDEQ_ETHEREUM_ADDRESS=

# `ltc1...`, or legacy `L...` / `M...`
FLUIDEQ_LITECOIN_ADDRESS=

# `D...`
FLUIDEQ_DOGECOIN_ADDRESS=

# `4...` or `8...` (95 characters)
FLUIDEQ_MONERO_ADDRESS=

# base58, 32-44 characters
FLUIDEQ_SOLANA_ADDRESS=

# Shelley-era `addr1...`
FLUIDEQ_CARDANO_ADDRESS=

# `T...` — TRC-20 network
FLUIDEQ_TRON_ADDRESS=

# Label a wallet shows when opening a payment URI.
# Defaults to "FluidEQ development".
FLUIDEQ_CRYPTO_LABEL=

# Where people can contribute time instead of money.
# Defaults to https://github.com/StartSWest/FluidEQ
FLUIDEQ_REPOSITORY_URL=
