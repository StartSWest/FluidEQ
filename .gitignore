# Logs
logs
*.log

# Runtime data
pids
*.pid
*.seed

# Coverage directory used by tools like istanbul
coverage
.eslintcache

# Dependency directory
# https://www.npmjs.org/doc/misc/npm-faq.html#should-i-check-my-node_modules-folder-into-git
node_modules
.pnpm-store/

# OSX
.DS_Store

release/app/dist
release/build
build
.erb/dll

.idea
npm-debug.log.*
*.css.d.ts
*.sass.d.ts
*.scss.d.ts

# Local build-time configuration. `.env.example` documents the variables and
# is the only one that gets committed.
.env
.env.*
!.env.example

# App files
presets/**

# Equalizer APO is fetched at build time, not committed. See
# .erb/scripts/fetch-equalizer-apo.ts
/vendor

# Clyvor metadata
.gigaide/

# Local launch config for Claude Code; not part of the build.
.claude/

# Audio dropped in the working tree while testing the Karaoke Maker. These are
# commercial recordings used to check separation and lyric timing against a
# real mix, and they are megabytes each — they belong on the machine doing the
# testing, never in the history of a public repository.
/*.mp3
/*.Mp3
/*.MP3
/*.wav
/*.flac
/*.m4a

# The karaoke files exported beside them, for the same reason and one more: a
# timed lyric sheet is somebody else's words whether or not the audio ever left
# the machine. Two exports of a commercial single sat at this root for months,
# committed by a change that had nothing to do with karaoke, which is exactly
# how a file nobody meant to publish gets published.
/*.txt
/*.lrc
/*.elrc

# The native build tree, and the parameter header generated into the source
# tree beside it. The header is regenerated by `pnpm build:native-dsp` from
# `src/common/dsp/nativeParameters.ts` on every build, so a committed copy
# could only ever be a second, staler answer to the same question.
native/.build/
native/dsp-core/include/fluideq/parameters.h
