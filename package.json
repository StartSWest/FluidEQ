{
  "name": "fluideq",
  "version": "0.6.1",
  "type": "commonjs",
  "description": "Open-source system-wide parametric EQ with automatic per-device profiles",
  "keywords": [
    "electron",
    "equalizer-apo",
    "audio",
    "parametric-eq",
    "device-profiles",
    "react",
    "typescript",
    "ts",
    "sass",
    "webpack",
    "hot",
    "reload"
  ],
  "homepage": "https://github.com/StartSWest/FluidEQ",
  "packageManager": "pnpm@11.7.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/StartSWest/FluidEQ.git"
  },
  "license": "GPL-3.0-or-later",
  "author": {
    "name": "FluidEQ contributors"
  },
  "contributors": [
    "AQUA Dev Team",
    "FluidEQ contributors"
  ],
  "main": "./src/main/main.ts",
  "scripts": {
    "dev": "pnpm start",
    "build": "concurrently \"pnpm build:main\" \"pnpm build:renderer\"",
    "build:main": "cross-env NODE_ENV=production TS_NODE_TRANSPILE_ONLY=true webpack --config ./.erb/configs/webpack.config.main.prod.cjs",
    "build:renderer": "cross-env NODE_ENV=production TS_NODE_TRANSPILE_ONLY=true webpack --config ./.erb/configs/webpack.config.renderer.prod.cjs",
    "postinstall": "ts-node .erb/scripts/postinstall.ts",
    "lint": "cross-env NODE_ENV=development eslint . --ext .js,.jsx,.ts,.tsx",
    "package": "ts-node ./.erb/scripts/clean.js dist && pnpm build && electron-builder build --publish never",
    "prepare": "husky",
    "rebuild": "electron-rebuild --parallel --types prod,dev,optional --module-dir release/app",
    "start": "ts-node ./.erb/scripts/check-port-in-use.js && pnpm start:renderer",
    "start:main": "cross-env NODE_ENV=development electronmon dev-main.cjs --no-sandbox",
    "start:preload": "cross-env NODE_ENV=development TS_NODE_TRANSPILE_ONLY=true webpack --config ./.erb/configs/webpack.config.preload.dev.cjs",
    "start:renderer": "cross-env NODE_ENV=development TS_NODE_TRANSPILE_ONLY=true webpack serve --config ./.erb/configs/webpack.config.renderer.dev.cjs",
    "test": "jest",
    "test:unit": "jest --testMatch \"**/__tests__/unit_tests/**/*.ts?(x)\"",
    "test:cucumber": "jest --testMatch \"**/__tests__/cucumber_tests/*.ts?(x)\" --runInBand",
    "test:autoeq": "cross-env TS_NODE_TRANSPILE_ONLY=true ts-node src/__tests__/utils/autoeqRegexTest.ts",
    "autoeq:update": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/update-autoeq.ps1",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "typecheck:e2e": "tsc --noEmit -p tsconfig.e2e.json"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "cross-env NODE_ENV=development eslint --cache"
    ],
    "*.json,.{eslintrc,prettierrc}": [
      "prettier --ignore-path .eslintignore --parser json --write"
    ],
    "*.{css,scss}": [
      "prettier --ignore-path .eslintignore --single-quote --write"
    ],
    "*.{html,md,yml}": [
      "prettier --ignore-path .eslintignore --single-quote --write"
    ]
  },
  "browserslist": [],
  "prettier": {
    "singleQuote": true,
    "overrides": [
      {
        "files": [
          ".prettierrc",
          ".eslintrc"
        ],
        "options": {
          "parser": "json"
        }
      }
    ]
  },
  "jest": {
    "moduleDirectories": [
      "src",
      "node_modules",
      "release/app/node_modules"
    ],
    "moduleFileExtensions": [
      "js",
      "jsx",
      "ts",
      "tsx",
      "json"
    ],
    "moduleNameMapper": {
      "\\.(jpg|jpeg|png|gif|eot|otf|webp|svg|ttf|woff|woff2|mp4|webm|wav|mp3|m4a|aac|oga)$": "<rootDir>/.erb/mocks/fileMock.js",
      "\\.(css|less|sass|scss)$": "identity-obj-proxy",
      "d3": "<rootDir>/node_modules/d3/dist/d3.min.js"
    },
    "setupFiles": [
      "./.erb/scripts/check-build-exists.ts",
      "./.erb/scripts/jest-setup.ts"
    ],
    "testEnvironment": "jsdom",
    "testEnvironmentOptions": {
      "url": "http://localhost/"
    },
    "testPathIgnorePatterns": [
      "release/app/dist",
      "<rootDir>/.claude/"
    ],
    "modulePathIgnorePatterns": [
      "<rootDir>/.claude/"
    ],
    "transform": {
      "\\.(ts|tsx|js|jsx)$": "ts-jest"
    },
    "testMatch": [
      "**/__tests__/unit_tests/**/*.ts?(x)"
    ],
    "transformIgnorePatterns": [
      "/node_modules/(?!(uuid)/)",
      "\\.pnp\\.[^\\/]+$"
    ]
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "d3": "^7.9.0",
    "electron-debug": "^4.1.0",
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.9",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "regedit": "^5.1.4",
    "uid": "^2.0.2"
  },
  "devDependencies": {
    "@electron/notarize": "^3.1.1",
    "@electron/rebuild": "^4.2.0",
    "@pmmmwh/react-refresh-webpack-plugin": "^0.6.2",
    "@rkesters/typescript-json-validator": "^3.0.3",
    "@teamsupercell/typings-for-css-modules-loader": "^2.5.2",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/d3": "^7.4.3",
    "@types/d3-dispatch": "3.0.7",
    "@types/jest": "^29.5.14",
    "@types/node": "26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/react-test-renderer": "^19.1.0",
    "@types/webpack-bundle-analyzer": "^4.7.0",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "browserslist-config-erb": "^0.0.3",
    "chalk": "^4.1.2",
    "concurrently": "^10.0.4",
    "core-js": "^3.49.0",
    "cross-env": "^10.1.0",
    "css-loader": "^7.1.4",
    "css-minimizer-webpack-plugin": "^8.0.0",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "electron-chromedriver": "^42.8.0",
    "electron-devtools-installer": "^4.0.0",
    "electronmon": "^2.0.4",
    "eslint": "^8.57.1",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-erb": "^4.1.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-import-resolver-webpack": "^0.13.11",
    "eslint-plugin-compat": "^6.2.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jest": "^29.16.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-promise": "^7.3.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "file-loader": "^6.2.0",
    "html-webpack-plugin": "^5.6.8",
    "husky": "^9.1.7",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^29.7.0",
    "jest-cucumber": "^4.5.0",
    "jest-environment-jsdom": "^29.7.0",
    "lint-staged": "^17.3.0",
    "mini-css-extract-plugin": "^2.10.2",
    "node-gyp": "^13.0.1",
    "prettier": "^3.9.6",
    "react-refresh": "^0.18.0",
    "react-test-renderer": "^19.2.8",
    "resedit": "^1.7.2",
    "rimraf": "^6.1.3",
    "sass": "^1.102.0",
    "sass-loader": "^17.0.0",
    "source-map-support": "^0.5.21",
    "style-loader": "^4.0.0",
    "terser-webpack-plugin": "^5.6.1",
    "ts-jest": "^29.4.12",
    "ts-loader": "^9.6.2",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "url-loader": "^4.1.1",
    "webdriverio": "^9.30.0",
    "webpack": "^5.109.2",
    "webpack-bundle-analyzer": "^5.3.1",
    "webpack-cli": "^7.2.2",
    "webpack-dev-server": "^5.2.6",
    "webpack-merge": "^6.0.1"
  },
  "build": {
    "productName": "FluidEQ",
    "appId": "com.gigabytz.fluideq",
    "asar": true,
    "asarUnpack": "**\\*.{node,dll}",
    "files": [
      "dist",
      "node_modules",
      "package.json"
    ],
    "afterSign": ".erb/scripts/notarize.js",
    "mac": {
      "target": {
        "target": "default",
        "arch": [
          "arm64",
          "x64"
        ]
      },
      "type": "distribution",
      "hardenedRuntime": true,
      "entitlements": "assets/entitlements.mac.plist",
      "entitlementsInherit": "assets/entitlements.mac.plist",
      "gatekeeperAssess": false
    },
    "dmg": {
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "runAfterFinish": true,
      "artifactName": "${productName}-Setup-${version}.${ext}",
      "license": "assets/licenses/LICENSE.txt",
      "multiLanguageInstaller": true,
      "displayLanguageSelector": true,
      "installerLanguages": [
        "en_US",
        "zh_CN",
        "es_ES",
        "fr_FR",
        "pt_BR",
        "ru_RU",
        "ja_JP",
        "de_DE",
        "it_IT"
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "AudioVideo"
    },
    "directories": {
      "app": "release/app",
      "buildResources": "assets",
      "output": "release/build"
    },
    "extraResources": [
      "./assets/**",
      {
        "from": "node_modules/regedit/vbs",
        "to": "vbs",
        "filter": [
          "**/*"
        ]
      },
      "./autoeq/**",
      "./CHANGELOG.md"
    ],
    "publish": {
      "provider": "github",
      "owner": "StartSWest",
      "repo": "FluidEQ"
    }
  },
  "devEngines": {
    "node": ">=22.x",
    "npm": ">=7.x"
  },
  "electronmon": {
    "patterns": [
      "!**/**",
      "src/main/*"
    ],
    "logLevel": "quiet"
  }
}
