+    // EPERM, which rejected this listener's promise and killed `pnpm dev`.
+    // A path that is neither known nor wanted is none of this watcher's
+    // business, so it is dropped before anything touches the disk.
+    if (
+      type !== EV_DISCOVER &&
+      !dirs.has(changepath) &&
+      !shouldWatch(changepath, absolutePatterns)
+    ) {
+      return;
+    }
