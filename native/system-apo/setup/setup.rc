/*
 * The version resource, which the consent prompt reads out loud.
 *
 * This is the one program in the product that asks for administrator rights,
 * and what the user is shown before deciding is the FileDescription and the
 * publisher from this block. An unnamed binary asking to change the machine
 * is a binary a careful person says no to, and rightly.
 *
 * "FluidEQ Audio Processing Engine Setup", in full, because that is the name
 * the installer's engine page has just used. The consent prompt arrives
 * seconds after it, and a name that does not match the one on the page is
 * indistinguishable from something else having asked.
 *
 * FEQ_CORE_VERSION is a marketing string ("0.1.0-identity"), not four
 * numbers, so the binary version fields stay at 1.0.0.0 and the string goes
 * where a string belongs.
 */

#include <winver.h>

#ifndef FEQ_SETUP_VERSION_STRING
#define FEQ_SETUP_VERSION_STRING "0.0.0"
#endif

VS_VERSION_INFO VERSIONINFO
FILEVERSION 1, 0, 0, 0
PRODUCTVERSION 1, 0, 0, 0
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE VFT2_UNKNOWN
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName", "Ivan Carmenates Garcia"
      VALUE "FileDescription", "FluidEQ Audio Processing Engine Setup"
      VALUE "FileVersion", FEQ_SETUP_VERSION_STRING
      VALUE "InternalName", "FluidEQ-Engine-Setup"
      VALUE "LegalCopyright", "Copyright (C) 2026 Ivan Carmenates Garcia. GPL-3.0-or-later."
      VALUE "OriginalFilename", "FluidEQ-Engine-Setup.exe"
      VALUE "ProductName", "FluidEQ Audio Processing Engine Setup"
      VALUE "ProductVersion", FEQ_SETUP_VERSION_STRING
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
