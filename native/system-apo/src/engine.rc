/*
 * The version resource, which here is not a nicety.
 *
 * This DLL loads into audiodg.exe, a process the user never launched and
 * cannot inspect from Task Manager's process list. When system audio breaks,
 * the first thing anyone does is look at what is loaded into it — and an
 * unnamed DLL in that list is indistinguishable from something that has no
 * business being there. FileDescription and CompanyName are how this one says
 * whose it is.
 *
 * FEQ_CORE_VERSION is a marketing string ("0.1.0-identity"), not four
 * numbers, so the string goes where a string belongs and the binary fields
 * carry something else: which of the app's expectations this engine meets.
 * The setup helper reports FILEVERSION of the installed DLL as `dllVersion`,
 * and the app reads it before it relies on anything a later engine does.
 *
 *   1.0  processes audio.
 *   1.1  also writes status-{GUID}.json for every output it runs. Before it,
 *        a missing status was every engine's normal; after it, a missing
 *        status while sound plays means the engine is not there.
 *
 *   1.2  also serves the system DSP's stage measurements to the DSP page.
 *   1.7  also levels by song: reads fluideq-programme.txt, keeps what live
 *        leveling learned across locks, and reports each finished song as
 *        `lastSong` in its status. An older engine ignores the file.
 *   1.8  also answers the display connection's process-stats request (3)
 *        with its host process's id, working set and CPU time, for the
 *        Processes list, and says so in its handshake (bit 2 of byte 39). An
 *        older engine would read the request as "meters off" and never
 *        answer, so the app asks only a connection that set the bit.
 *   1.9  also reports carried audio.
 *   1.10 supports the shared Game mode control and reports all processing
 *        delay parts, including active stages that add no buffering.
 *   1.11 supports the versioned Room trailer and comparison telemetry.
 *   1.12 its setup helper takes the one-value slots (`efx-single`,
 *        `mfx-single`, `sfx-single`) on the slot ladder.
 *   1.13 builds a layer's bands analog-matched where the file says
 *        `# FluidEQFilterDesign: MATCHED`, and the graph draws that shape
 *        only from here on; an older engine reads the line as a comment.
 * ENGINE_STATUS_SINCE stays at 1.1: older status-capable engines still report
 * their health even when the new display connection is unavailable.
 */

#include <winver.h>

#ifndef FEQ_ENGINE_VERSION_STRING
#define FEQ_ENGINE_VERSION_STRING "0.0.0"
#endif

VS_VERSION_INFO VERSIONINFO
FILEVERSION 1, 13, 0, 0
PRODUCTVERSION 1, 13, 0, 0
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_DLL
FILESUBTYPE VFT2_UNKNOWN
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName", "Ivan Carmenates Garcia"
      VALUE "FileDescription", "FluidEQ Engine"
      VALUE "FileVersion", FEQ_ENGINE_VERSION_STRING
      VALUE "InternalName", "FluidEQ-Engine"
      VALUE "LegalCopyright", "Copyright (C) 2026 Ivan Carmenates Garcia. GPL-3.0-or-later."
      VALUE "OriginalFilename", "FluidEQ-Engine.dll"
      VALUE "ProductName", "FluidEQ"
      VALUE "ProductVersion", FEQ_ENGINE_VERSION_STRING
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
