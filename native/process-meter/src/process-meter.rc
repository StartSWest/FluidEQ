/*
 * Task Manager's Name column for the meter, which runs only while the
 * Processes list is open and should say so rather than read "FluidEQ".
 */

#include <winver.h>

#ifndef FEQ_METER_VERSION_STRING
#define FEQ_METER_VERSION_STRING "0.0.0"
#endif

VS_VERSION_INFO VERSIONINFO
FILEVERSION 1, 0, 0, 0
PRODUCTVERSION 1, 0, 0, 0
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE VFT2_UNKNOWN
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName", "Ivan Carmenates Garcia"
      VALUE "FileDescription", "FluidEQ Process Meter"
      VALUE "FileVersion", FEQ_METER_VERSION_STRING
      VALUE "InternalName", "FluidEQ-Meter"
      VALUE "LegalCopyright", "Copyright (C) 2026 Ivan Carmenates Garcia. GPL-3.0-or-later."
      VALUE "OriginalFilename", "FluidEQ-Meter.exe"
      VALUE "ProductName", "FluidEQ"
      VALUE "ProductVersion", FEQ_METER_VERSION_STRING
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
