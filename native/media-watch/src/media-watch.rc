/*
 * Task Manager's Name column for the media helper, which runs while the
 * transport bar wants to know what other programs are playing and should say
 * what it is doing rather than read "FluidEQ" beside nine other rows.
 */

#include <winver.h>

#ifndef FEQ_MEDIA_VERSION_STRING
#define FEQ_MEDIA_VERSION_STRING "0.0.0"
#endif

VS_VERSION_INFO VERSIONINFO
FILEVERSION 1, 0, 0, 0
PRODUCTVERSION 1, 0, 0, 0
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE VFT2_UNKNOWN
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName", "Ivan Carmenates Garcia"
      VALUE "FileDescription", "FluidEQ Other Apps' Media"
      VALUE "FileVersion", FEQ_MEDIA_VERSION_STRING
      VALUE "InternalName", "FluidEQ-Media"
      VALUE "LegalCopyright", "Copyright (C) 2026 Ivan Carmenates Garcia. GPL-3.0-or-later."
      VALUE "OriginalFilename", "FluidEQ-Media.exe"
      VALUE "ProductName", "FluidEQ"
      VALUE "ProductVersion", FEQ_MEDIA_VERSION_STRING
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
