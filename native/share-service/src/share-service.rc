/*
 * The name Windows shows for Share Audio's link: in Task Manager, and in the
 * firewall's question the first time it listens for the other computers,
 * where a program that cannot say what it is gets refused.
 */

#include <winver.h>

#ifndef FEQ_SHARE_VERSION_STRING
#define FEQ_SHARE_VERSION_STRING "0.0.0"
#endif

VS_VERSION_INFO VERSIONINFO
FILEVERSION 1, 0, 0, 0
PRODUCTVERSION 1, 0, 0, 0
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE VFT2_UNKNOWN
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName", "Ivan Carmenates Garcia"
      VALUE "FileDescription", "FluidEQ Share Audio"
      VALUE "FileVersion", FEQ_SHARE_VERSION_STRING
      VALUE "InternalName", "FluidEQ-Share"
      VALUE "LegalCopyright", "Copyright (C) 2026 Ivan Carmenates Garcia. GPL-3.0-or-later."
      VALUE "OriginalFilename", "FluidEQ-Share.exe"
      VALUE "ProductName", "FluidEQ"
      VALUE "ProductVersion", FEQ_SHARE_VERSION_STRING
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
