class HeadroomMeter extends AudioWorkletProcessor {
  constructor() {
    super();
    this.peak = 0;
    this.frames = 0;
    this.windowFrames = Math.max(1, Math.round(sampleRate / 10));
    this.startedAt = 0;
  }

  process(inputs) {
    const channels = inputs[0];
    if (!channels || channels.length === 0) return true;
    const frames = channels[0].length;
    for (let frame = 0; frame < frames; frame += 1) {
      if (this.frames === 0) this.startedAt = currentTime + frame / sampleRate;
      for (const channel of channels) {
        this.peak = Math.max(this.peak, Math.abs(channel[frame] || 0));
      }
      this.frames += 1;
      if (this.frames === this.windowFrames) {
        this.port.postMessage({
          peakDbfs: this.peak > 0 ? 20 * Math.log10(this.peak) : -240,
          durationMs: 1000 * this.frames / sampleRate,
          startedAt: this.startedAt,
        });
        this.peak = 0;
        this.frames = 0;
      }
    }
    return true;
  }
}

registerProcessor('fluideq-headroom-meter', HeadroomMeter);
